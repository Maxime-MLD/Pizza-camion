# Optional initial VAPID key import for a manual deployment. Never commit a real .env.
# The deployed worker normally generates both keys and stores the private key in Supabase Vault.
# Keep an existing pair stable: changing keys requires resubscribing devices.
VAPID_PUBLIC_KEY=TODO_OPTIONAL_PUBLIC_KEY
VAPID_PRIVATE_KEY=TODO_OPTIONAL_SERVER_ONLY_PRIVATE_KEY
# VAPID_SUBJECT is configured in private push_config during the owner-only bootstrap.
# SUPABASE_URL and server API keys are supplied by Supabase, never copied into browser code.
