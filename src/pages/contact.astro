---
import Section from "../components/ui/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="TODO_CONTACT_PAGE_TITLE"
  description="TODO_CONTACT_PAGE_META_DESCRIPTION"
  navbarSticky
>
  <!-- TODO_PAGE_TEMPLATE: compléter ou supprimer cette page avant la livraison. -->
  <Section
    id="TODO_CONTACT_TEMPLATE_ID"
    spacing="lg"
    aria-labelledby="TODO_CONTACT_TITLE_ID"
  >
    <SectionHeader
      eyebrow="TODO_PAGE_TEMPLATE_LABEL"
      title="TODO_CONTACT_H1"
      description="TODO_CONTACT_INTRODUCTION"
      level={1}
      headingId="TODO_CONTACT_TITLE_ID"
    />
  </Section>
</BaseLayout>
