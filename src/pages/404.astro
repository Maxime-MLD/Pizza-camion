---
import Button from "../components/ui/Button.astro";
import Section from "../components/ui/Section.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="TODO_404_PAGE_TITLE"
  description="TODO_404_PAGE_DESCRIPTION"
  noindex
  nofollow
  navbarVariant="light"
>
  <Section spacing="lg" aria-labelledby="not-found-title">
    <div class="mx-auto max-w-3xl text-center">
      <SectionHeader
        eyebrow="404"
        title="TODO_404_H1"
        description="TODO_404_MESSAGE"
        level={1}
        headingId="not-found-title"
        align="center"
      />
      <div class="mt-8">
        <Button href="/" variant="primary">Retour à l’accueil</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
