---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

type ImageLayout = "constrained" | "full-width" | "fixed";
type ImageFormat = "avif" | "webp";
type FallbackFormat = ImageFormat | "jpeg" | "jpg" | "png";
type ImageQuality = number | "low" | "mid" | "high" | "max";

export interface Props {
  src: ImageMetadata | Promise<{ default: ImageMetadata }>;
  alt: string;
  decorative?: boolean;
  priority?: boolean;
  layout?: ImageLayout;
  width?: number;
  height?: number;
  widths?: number[];
  sizes?: string;
  formats?: ImageFormat[];
  fallbackFormat?: FallbackFormat;
  quality?: ImageQuality;
  class?: string;
  pictureClass?: string;
}

const {
  src,
  alt,
  decorative = false,
  priority = false,
  layout = "constrained",
  width,
  height,
  widths,
  sizes,
  formats = ["avif", "webp"],
  fallbackFormat,
  quality = "high",
  class: className,
  pictureClass,
} = Astro.props as Props;

if (decorative && alt !== "") {
  throw new Error("ResponsiveImage: une image décorative doit utiliser alt=\"\".");
}

if (!decorative && alt.trim().length === 0) {
  throw new Error(
    "ResponsiveImage: fournissez un texte alternatif ou marquez explicitement l'image comme décorative.",
  );
}

const imageClass = [
  "h-auto max-w-full",
  layout === "full-width" && "w-full",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<!-- Le style de ratio généré par Astro est nécessaire pour prévenir le CLS. -->
<Picture
  src={src}
  alt={alt}
  formats={formats}
  fallbackFormat={fallbackFormat}
  quality={quality}
  layout={layout}
  width={width}
  height={height}
  widths={widths}
  sizes={sizes}
  priority={priority}
  class={imageClass}
  role={decorative ? "presentation" : undefined}
  aria-hidden={decorative ? "true" : undefined}
  pictureAttributes={{ class: pictureClass }}
/>
