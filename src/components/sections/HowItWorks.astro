---
import { howItWorksConfig } from "../../config/how-it-works.config";
import { orderSteps } from "../../data/orderSteps";
import Container from "../ui/Container.astro";
---

<section id="comment-ca-marche" aria-labelledby="how-title" class="relative isolate overflow-x-clip bg-[var(--color-how-background)] py-20 text-[var(--color-how-foreground)] sm:py-24 lg:py-28">
  <div class="pointer-events-none absolute inset-x-0 top-0 z-0 h-[38rem] bg-[radial-gradient(ellipse_at_top_left,var(--color-how-glow)_0%,transparent_70%)]" aria-hidden="true"></div>
  <Container class="relative z-10">
    <header data-how-reveal class="max-w-[58rem] motion-safe:transition-[opacity,transform] motion-safe:duration-500 motion-safe:ease-[var(--ease-premium)]">
      <p class="font-display text-base font-extrabold uppercase tracking-[0.16em] text-[var(--color-accent)] sm:text-lg">{howItWorksConfig.eyebrow}</p>
      <h2 id="how-title" class="mt-4 font-display text-[clamp(3.75rem,8.5vw,8rem)] leading-[0.83] font-extrabold uppercase tracking-[-0.035em]">
        <span class="block">{howItWorksConfig.titleLineOne}</span>
        <span class="block">{howItWorksConfig.titleLineTwo}</span>
      </h2>
      <p class="mt-7 max-w-[34rem] text-base leading-relaxed text-[var(--color-how-muted)] sm:mt-9 sm:text-lg">{howItWorksConfig.description}</p>
    </header>

    <ol class="mt-12 grid min-w-0 gap-5 sm:mt-16 sm:gap-7 md:grid-cols-2 lg:grid-cols-3 lg:gap-6 xl:gap-8">
      {orderSteps.map((step, index) => (
        <li data-how-reveal class:list={["flex min-h-[24rem] min-w-0 flex-col rounded-[var(--radius-lg)] border border-[var(--color-border-strong)] bg-[var(--color-how-card)] p-6 motion-safe:transition-[opacity,transform] motion-safe:duration-500 motion-safe:ease-[var(--ease-premium)] sm:p-8 lg:min-h-[27rem] lg:p-7 xl:p-10", index === 1 && "motion-safe:delay-75", index === 2 && "motion-safe:delay-150 md:col-span-2 lg:col-span-1"]}>
          <span aria-hidden="true" class:list={["font-display text-[clamp(5.5rem,8vw,8.5rem)] leading-[0.75] font-extrabold tracking-[-0.06em]", step.accent === "saffron" ? "text-[var(--color-accent)]" : step.accent === "tomato" ? "text-[var(--color-primary)]" : "text-[var(--color-secondary)]"]}>{step.number}</span>
          <div class="mt-12 flex flex-1 flex-col justify-end sm:mt-16">
            <h3 class="font-display text-[clamp(2.15rem,3.2vw,3.5rem)] leading-[0.9] font-extrabold uppercase tracking-[-0.025em] break-words">
              <span class="block">{step.titleLineOne}</span>
              <span class="block">{step.titleLineTwo}</span>
            </h3>
            <p class="mt-6 max-w-[30rem] border-t border-[var(--color-border-strong)] pt-5 text-base leading-[1.65] text-[var(--color-how-muted)]">{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </Container>
</section>

<script>import "../../scripts/how-reveal";</script>
