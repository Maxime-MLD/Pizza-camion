---
import { brandConfig } from "../../config/brand.config";
// TODO_IMAGE : illustration générée pour la Hero, à remplacer si une photographie de marque est disponible.
import pizzaVisual from "../../assets/forno-hero-floating-pizza.webp";
import { getTodayDisplay } from "../../utils/truckToday";
import { isPlaceholderValue } from "../../utils/placeholders";
import Container from "../ui/Container.astro";
import ResponsiveImage from "../ui/ResponsiveImage.astro";

const today = getTodayDisplay(new Date());
const orderReady = !isPlaceholderValue(brandConfig.orderUrl) && today.isOpen;
const scheduleReady = !isPlaceholderValue(brandConfig.scheduleUrl);
---

<!-- La Navbar transparente se superpose à ce fond unique : aucun raccord de dégradé. -->
<section id="hero" aria-labelledby="hero-title" class="relative overflow-x-clip bg-[var(--color-hero-base)] bg-[image:var(--background-hero)] pt-[7.75rem] md:pt-[5.5rem] lg:pt-[6.5rem]">
  <Container class="grid min-h-[calc(100svh-7.5rem)] items-center gap-10 py-10 sm:py-14 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)] lg:gap-0 lg:py-12 xl:py-14">
    <div class="relative z-10 min-w-0 max-w-[48rem]">
      <div class="motion-enter inline-flex max-w-full flex-wrap items-center gap-x-2 gap-y-1 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2 text-[0.75rem] font-bold sm:text-[0.86rem]">
        <span data-today-badge>{today.badge}</span><span class="text-[var(--color-muted-foreground)]" aria-hidden="true">·</span><span class="text-[var(--color-muted-foreground)]" data-today-meta>{today.meta}</span>
      </div>

      <h1 id="hero-title" class="motion-enter mt-7 text-[clamp(3.75rem,12vw,8.5rem)] leading-[0.84] font-extrabold tracking-[-0.048em] sm:mt-9 lg:text-[clamp(5.2rem,8.5vw,9rem)]">
        <span class="block" data-today-heading-top>{today.headingTop}</span>
        <span class="block" data-today-heading-middle>{today.headingMiddle}</span>
        <span class="block break-words text-[var(--color-primary)]" data-today-heading-place>{today.headingPlace}</span>
      </h1>

      <p class="mt-7 max-w-[35rem] text-[clamp(1rem,1.5vw,1.25rem)] leading-relaxed text-[var(--color-text)] sm:mt-9">{brandConfig.description}</p>

      <div class="motion-enter mt-8 flex flex-wrap items-center gap-3 sm:mt-9">
        <a href={orderReady ? brandConfig.orderUrl : undefined} aria-disabled={!orderReady ? "true" : undefined} tabindex={!orderReady ? -1 : undefined} data-order-link class="focus-ring inline-flex min-h-12 items-center justify-center rounded-full bg-[var(--color-primary)] px-6 py-3 text-button text-[var(--color-on-primary)] no-underline shadow-[0_0.5rem_1.2rem_rgb(229_58_34_/_0.16)] transition-colors hover:bg-[var(--color-primary-dark)] aria-disabled:opacity-70">{brandConfig.labels.orderPizzas}<span aria-hidden="true" class="ml-2">↗</span></a>
        <a href={scheduleReady ? brandConfig.scheduleUrl : undefined} aria-disabled={!scheduleReady ? "true" : undefined} tabindex={!scheduleReady ? -1 : undefined} class="focus-ring inline-flex min-h-12 items-center justify-center rounded-full border border-[var(--color-border-strong)] bg-[var(--color-surface)] px-6 py-3 text-button no-underline transition-colors hover:bg-[var(--color-surface-2)] aria-disabled:opacity-70">{brandConfig.labels.schedule}<span aria-hidden="true" class="ml-2">↗</span></a>
      </div>

      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-4 border-t border-[var(--color-border)] pt-6 text-[0.82rem] sm:mt-12" id="service-info">
        <p class="flex items-start gap-2"><span aria-hidden="true" class="text-[var(--color-primary)]">⌖</span><span><span class="block text-label text-[var(--color-muted-foreground)]">Emplacement</span><span class="mt-1 block font-semibold" data-today-location>{today.location}</span></span></p>
        <p class="flex items-start gap-2"><span aria-hidden="true" class="text-[var(--color-primary)]">◷</span><span><span class="block text-label text-[var(--color-muted-foreground)]">Service</span><span class="mt-1 block font-semibold" data-today-hours>{today.hours}</span></span></p>
      </div>
    </div>

    <figure class="relative mx-auto w-full max-w-[24rem] motion-safe:animate-[hero-visual-enter_600ms_var(--ease-premium)_both] sm:max-w-[32rem] lg:-mr-4 lg:max-w-none xl:-mr-8">
      <ResponsiveImage src={pizzaVisual} alt={brandConfig.heroVisualAlt} priority layout="full-width" width={1122} height={1402} widths={[360, 560, 760, 960, 1122]} sizes="(max-width: 639px) 90vw, (max-width: 1023px) 32rem, 53vw" formats={["webp"]} fallbackFormat="webp" quality={85} class="mx-auto w-full object-contain lg:h-[clamp(34rem,53vw,44rem)]" />
      <figcaption class="sr-only">{brandConfig.heroVisualCaption} {brandConfig.temporaryVisualLabel}</figcaption>
    </figure>
  </Container>
</section>

<script>import "../../scripts/schedule-ui";</script>
