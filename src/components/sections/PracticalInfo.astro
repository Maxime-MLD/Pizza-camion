---
import { practicalInfo } from "../../data/practicalInfo";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";

export interface Props {
  title?: string;
}

const { title = "TODO_PRACTICAL_INFO_SECTION_TITLE" } = Astro.props as Props;
---

<Section
  id="practical-info"
  spacing="lg"
  width="full"
  aria-labelledby="practical-info-title"
>
  <Container>
    <!-- TODO_PRACTICAL_INFO_SECTION: valider les informations pratiques avant publication. -->
    <SectionHeader title={title} headingId="practical-info-title" />

    <dl class="mt-10 grid min-w-0 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        practicalInfo.map((item) => (
          <div class="safe-wrap rounded-[var(--radius-lg)] border border-[var(--color-border)] p-6">
            <dt class="font-semibold">{item.title}</dt>
            <dd class="mt-2 text-[var(--color-text-muted)]">{item.value}</dd>
            {item.description && <dd class="mt-2 text-small">{item.description}</dd>}
          </div>
        ))
      }
    </dl>
  </Container>
</Section>
