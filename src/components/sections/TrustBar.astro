---
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";

export interface Props {
  title?: string;
  items?: readonly string[];
}

const {
  title = "TODO_TRUST_BAR_TITLE",
  items = [],
} = Astro.props as Props;

const hasItems = items.length > 0;
---

<Section
  id="trust"
  spacing={hasItems ? "sm" : "none"}
  width="full"
  aria-labelledby="trust-title"
>
  <Container>
    <!-- TODO_TRUST_BAR: renseigner uniquement des preuves de confiance vérifiables. -->
    <h2 id="trust-title" class="sr-only">{title}</h2>
    {
      hasItems && (
        <ul class="m-0 grid min-w-0 list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-4">
          {items.map((item) => (
            <li class="safe-wrap text-small font-semibold">{item}</li>
          ))}
        </ul>
      )
    }
  </Container>
</Section>
