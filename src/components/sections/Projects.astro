---
import { projects } from "../../data/projects";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TODO_PROJECTS_SECTION_TITLE",
  description = "TODO_PROJECTS_SECTION_DESCRIPTION",
} = Astro.props as Props;
---

<Section id="projects" spacing="lg" width="full" aria-labelledby="projects-title">
  <Container>
    <!-- TODO_PROJECTS_SECTION: remplacer les projets exemples par des réalisations réelles. -->
    <SectionHeader title={title} description={description} headingId="projects-title" />

    <ul class="mt-10 grid min-w-0 list-none gap-6 p-0 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project) => (
          <li class="min-w-0">
            <article class="safe-wrap h-full rounded-[var(--radius-lg)] border border-[var(--color-border)] p-6">
              <p class="text-small text-[var(--color-text-muted)]">{project.category}</p>
              <h3 class="mt-3">{project.title}</h3>
              <p class="mt-4 text-[var(--color-text-muted)]">{project.summary}</p>
            </article>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>
