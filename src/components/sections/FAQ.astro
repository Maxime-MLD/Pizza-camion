---
import { faqItems } from "../../data/faq";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";

export interface Props {
  title?: string;
}

const { title = "TODO_FAQ_SECTION_TITLE" } = Astro.props as Props;
---

<Section id="faq" spacing="lg" width="full" aria-labelledby="faq-title">
  <Container>
    <!-- TODO_FAQ_SECTION: conserver uniquement les questions réellement utiles. -->
    <SectionHeader title={title} headingId="faq-title" />

    <div class="mt-10 grid min-w-0 gap-4">
      {
        faqItems.map((item) => (
          <details class="safe-wrap rounded-[var(--radius-md)] border border-[var(--color-border)] p-5">
            <summary class="focus-ring cursor-pointer rounded-[var(--radius-sm)] font-semibold">
              {item.question}
            </summary>
            <p class="mt-4 text-[var(--color-text-muted)]">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </Container>
</Section>
