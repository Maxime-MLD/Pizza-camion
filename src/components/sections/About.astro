---
import { businessConfig } from "../../config/business.config";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";

export interface Props {
  title?: string;
}

const { title = "TODO_ABOUT_SECTION_TITLE" } = Astro.props as Props;
---

<Section id="about" spacing="lg" width="full" aria-labelledby="about-title">
  <Container>
    <!-- TODO_ABOUT_SECTION: ajouter le contenu et le média validés par le client. -->
    <div class="grid min-w-0 gap-10 lg:grid-cols-2 lg:items-start">
      <SectionHeader
        title={title}
        description={businessConfig.shortDescription}
        headingId="about-title"
      />

      <div class="safe-wrap min-w-0">
        <p class="font-semibold">{businessConfig.tradeName}</p>
        <p class="mt-3 text-[var(--color-text-muted)]">{businessConfig.activity}</p>
        <slot />
      </div>
    </div>
  </Container>
</Section>
