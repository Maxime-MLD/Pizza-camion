---
import { businessConfig } from "../../config/business.config";
import { localAreas } from "../../data/localAreas";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";
import SectionHeader from "../ui/SectionHeader.astro";

export interface Props {
  title?: string;
}

const { title = "TODO_LOCAL_AREA_SECTION_TITLE" } = Astro.props as Props;
---

<Section id="local-area" spacing="lg" width="full" aria-labelledby="local-area-title">
  <Container>
    <!-- TODO_LOCAL_AREA_SECTION: vérifier chaque zone et son contenu local avant publication. -->
    <SectionHeader
      title={title}
      description={businessConfig.serviceArea.primaryArea}
      headingId="local-area-title"
    />

    <ul class="mt-10 grid min-w-0 list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {
        localAreas.map((area) => (
          <li class="safe-wrap rounded-[var(--radius-lg)] border border-[var(--color-border)] p-6">
            <h3>{area.name}</h3>
            <p class="mt-3 text-[var(--color-text-muted)]">{area.description}</p>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>
