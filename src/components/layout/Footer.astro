---
import { brandConfig } from "../../config/brand.config";
import { businessConfig } from "../../config/business.config";
import { footerConfig } from "../../config/footer.config";
import { createTelHref, isConfiguredLinkValue } from "../../utils/links";
import Container from "../ui/Container.astro";

export interface Props { class?: string; }
const { class: className } = Astro.props as Props;
const currentYear = new Intl.DateTimeFormat("fr-FR", { year: "numeric", timeZone: "Europe/Paris" }).format(new Date());
const phoneHref = createTelHref(businessConfig.contact.phoneNormalized);
const phoneLabel = isConfiguredLinkValue(businessConfig.contact.phoneDisplay)
  ? businessConfig.contact.phoneDisplay
  : businessConfig.contact.phoneNormalized;
const socialLinks = businessConfig.socialLinks.filter((link) => {
  if (!isConfiguredLinkValue(link.url) || !isConfiguredLinkValue(link.label)) return false;
  try { return ["https:", "http:"].includes(new URL(link.url).protocol); }
  catch { return false; }
});
const linkClass = "inline-flex min-h-11 items-center rounded-sm no-underline transition-colors duration-150 hover:text-[var(--color-accent)] focus-visible:outline-[var(--color-accent)]";
---

<footer class:list={["bg-[var(--color-footer-background)] text-[var(--color-footer-foreground)]", className]}>
  <Container class="pt-16 pb-7 sm:pt-20 sm:pb-8 lg:pt-24">
    <div class="grid min-w-0 gap-11 md:grid-cols-2 md:gap-x-12 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,0.7fr)_minmax(0,0.9fr)] lg:gap-x-16">
      <div class="min-w-0 md:col-span-2 lg:col-span-1">
        <a href="/#hero" aria-label={footerConfig.homeLabel} class="inline-block rounded-sm font-display text-[clamp(5rem,9vw,8rem)] leading-[0.8] font-extrabold tracking-[-0.045em] no-underline focus-visible:outline-[var(--color-accent)]">
          {brandConfig.wordmark}<span class="text-[var(--color-primary)]">.</span>
        </a>
        <p class="mt-4 text-[0.67rem] font-bold tracking-[0.18em] uppercase sm:text-xs">{brandConfig.baseline}</p>
        <p class="mt-6 max-w-[28rem] text-base leading-[1.7] text-[var(--color-footer-muted)]">{footerConfig.description}</p>
      </div>

      <nav aria-label={footerConfig.navigationLabel}>
        <h2 class="font-body text-xs font-extrabold tracking-[0.14em] text-[var(--color-accent)]">{footerConfig.navigationTitle}</h2>
        <ul class="mt-4 flex list-none flex-col p-0 text-base">
          {footerConfig.navigation.map((item) => <li><a href={item.href} class={linkClass}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="min-w-0">
        <h2 class="font-body text-xs font-extrabold tracking-[0.14em] text-[var(--color-accent)]">{footerConfig.contactTitle}</h2>
        {phoneHref && <p class="mt-4"><a href={phoneHref} class:list={[linkClass, "text-lg font-semibold"]}>{phoneLabel}</a></p>}
        {socialLinks.length > 0 && (
          <nav aria-label={footerConfig.socialLabel} class="mt-4">
            <ul class="flex list-none flex-col p-0">
              {socialLinks.map((link) => <li><a href={link.url} class={linkClass} target="_blank" rel="noopener noreferrer">{link.label}<span aria-hidden="true" class="ml-2">↗</span></a></li>)}
            </ul>
          </nav>
        )}
        <p class="mt-5 max-w-[18rem] text-base leading-[1.7] text-[var(--color-footer-muted)]">{footerConfig.contactNote}</p>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-[var(--color-border-strong)] pt-6 text-sm text-[var(--color-footer-muted)] sm:mt-16 lg:flex-row lg:items-center lg:justify-between lg:gap-8">
      <p class="leading-relaxed">© <span data-footer-year>{currentYear}</span> {brandConfig.name} — {footerConfig.copyright}</p>
      <nav aria-label={footerConfig.legalLabel}>
        <ul class="flex list-none flex-wrap gap-x-6 gap-y-1 p-0">
          {footerConfig.legalLinks.map((item) => <li><a href={item.href} class={linkClass}>{item.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </Container>
</footer>

<script>
  // Le site est statique : actualiser aussi l’année à l’ouverture sans attendre un nouveau build.
  const year = new Intl.DateTimeFormat("fr-FR", { year: "numeric", timeZone: "Europe/Paris" }).format(new Date());
  document.querySelectorAll<HTMLElement>("[data-footer-year]").forEach((node) => { node.textContent = year; });
</script>
