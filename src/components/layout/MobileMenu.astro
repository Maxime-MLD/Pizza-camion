---
import { brandConfig } from "../../config/brand.config";
import { getTodayDisplay } from "../../utils/truckToday";
import { isPlaceholderValue } from "../../utils/placeholders";
const today = getTodayDisplay(new Date());
const orderReady = !isPlaceholderValue(brandConfig.orderUrl) && today.isOpen;
---

<div class="xl:hidden" data-mobile-menu>
  <button type="button" aria-label={brandConfig.labels.openMenu} aria-controls="forno-mobile-menu" aria-expanded="false" data-mobile-menu-open class="focus-ring tap-target flex items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-surface)]">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
  </button>
  <dialog id="forno-mobile-menu" aria-label={brandConfig.labels.mobileNav} data-mobile-menu-dialog class="m-0 ml-auto h-dvh max-h-dvh w-[min(90vw,25rem)] max-w-none border-0 border-l border-[var(--color-border)] bg-[var(--color-background)] p-0 text-[var(--color-text)] backdrop:bg-[var(--color-overlay)]">
    <div class="flex min-h-full flex-col p-6">
      <div class="flex items-center justify-between border-b border-[var(--color-border)] pb-5">
        <span class="font-display text-4xl leading-none font-extrabold">{brandConfig.wordmark}<span class="text-[var(--color-primary)]">.</span></span>
        <button type="button" aria-label={brandConfig.labels.closeMenu} data-mobile-menu-close class="focus-ring tap-target flex items-center justify-center rounded-full border border-[var(--color-border)]"><svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 5 14 14M19 5 5 19" /></svg></button>
      </div>
      <nav aria-label={brandConfig.labels.mobileNav} class="flex-1 py-7">
        <ul class="m-0 list-none space-y-1 p-0">
          {brandConfig.navigation.map((item) => <li>{item.ready ? <a href={item.href} data-mobile-menu-link class="focus-ring block rounded-md py-3 font-display text-3xl leading-none font-extrabold no-underline">{item.label}</a> : <span class="block py-3 font-display text-3xl leading-none font-extrabold text-[var(--color-muted-foreground)]" title={brandConfig.labels.notReady}>{item.label}</span>}</li>)}
        </ul>
      </nav>
      <div class="border-t border-[var(--color-border)] pt-6">
        <p class="mb-4 text-small font-semibold" data-today-nav>{today.navStatus}</p>
        <a href={orderReady ? brandConfig.orderUrl : undefined} aria-disabled={!orderReady ? "true" : undefined} tabindex={!orderReady ? -1 : undefined} data-order-link class="focus-ring flex min-h-12 items-center justify-center rounded-full bg-[var(--color-primary)] px-6 text-button text-[var(--color-on-primary)] no-underline aria-disabled:opacity-70">{brandConfig.labels.order}</a>
      </div>
    </div>
  </dialog>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const openButton = root?.querySelector<HTMLButtonElement>("[data-mobile-menu-open]");
  const closeButton = root?.querySelector<HTMLButtonElement>("[data-mobile-menu-close]");
  const dialog = root?.querySelector<HTMLDialogElement>("[data-mobile-menu-dialog]");
  if (openButton && closeButton && dialog) {
    openButton.addEventListener("click", () => { dialog.showModal(); openButton.setAttribute("aria-expanded", "true"); closeButton.focus(); });
    closeButton.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => { if (event.target === dialog || (event.target instanceof Element && event.target.closest("[data-mobile-menu-link]"))) dialog.close(); });
    dialog.addEventListener("close", () => { openButton.setAttribute("aria-expanded", "false"); openButton.focus({ preventScroll: true }); });
  }
</script>
