---
import { brandConfig } from "../../config/brand.config";
import { getTodayDisplay } from "../../utils/truckToday";
import { isPlaceholderValue } from "../../utils/placeholders";
import Container from "../ui/Container.astro";
import MobileMenu from "./MobileMenu.astro";

export interface Props { class?: string; variant?: "default" | "transparent" | "light" | "dark"; sticky?: boolean; overlay?: boolean; }
const { class: className, variant = "default", sticky = false, overlay = false } = Astro.props as Props;
const today = getTodayDisplay(new Date());
const orderReady = !isPlaceholderValue(brandConfig.orderUrl) && today.isOpen;
---

<header class:list={["z-40", !overlay && "border-b border-[var(--color-border)]", sticky ? "sticky top-0" : overlay ? "absolute inset-x-0 top-0" : "relative", variant === "light" ? "bg-[var(--color-surface)]" : variant === "dark" ? "bg-[var(--color-text)] text-[var(--color-primary-foreground)]" : variant === "transparent" ? "bg-transparent" : "bg-[var(--color-background)]", className]}>
  <Container class="flex min-h-[5.5rem] items-center justify-between gap-5 lg:min-h-[6.5rem]">
    <a href="/" aria-label="FORNO. — accueil" class="focus-ring shrink-0 rounded-sm no-underline">
      <span class="block font-display text-[2.2rem] leading-[0.8] font-extrabold tracking-[-0.045em] lg:text-[2.8rem]">
        {brandConfig.wordmark}<span class="text-[var(--color-primary)]">.</span>
      </span>
      <span class="mt-1.5 block font-body text-[0.53rem] leading-none font-bold tracking-[0.17em] lg:text-[0.64rem]">{brandConfig.baseline}</span>
    </a>

    <nav aria-label={brandConfig.labels.mainNav} class="hidden xl:block">
      <ul class="m-0 flex list-none items-center gap-1 p-0">
        {brandConfig.navigation.map((item) => (
          <li>
            {item.ready ? (
              <a href={item.href} aria-current={item.href === Astro.url.pathname ? "page" : undefined} class="focus-ring rounded-full px-3 py-2 text-[0.86rem] font-semibold no-underline transition-colors hover:text-[var(--color-primary)]" >{item.label}</a>
            ) : (
              <span title={brandConfig.labels.notReady} class="px-3 py-2 text-[0.86rem] font-semibold text-[var(--color-muted-foreground)]">{item.label}</span>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <span class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2 text-[0.78rem] font-semibold whitespace-nowrap" data-today-nav>{today.navStatus}</span>
      <a
        href={orderReady ? brandConfig.orderUrl : undefined}
        aria-disabled={!orderReady ? "true" : undefined}
        tabindex={!orderReady ? -1 : undefined}
        title={!orderReady ? brandConfig.labels.notReady : undefined}
        class="focus-ring inline-flex min-h-11 items-center justify-center rounded-full bg-[var(--color-primary)] px-5 text-button text-[var(--color-on-primary)] no-underline transition-colors hover:bg-[var(--color-primary-dark)] aria-disabled:opacity-70"
        data-order-link
      >{brandConfig.labels.order}<span aria-hidden="true" class="ml-2">↗</span></a>
    </div>

    <MobileMenu />
  </Container>
  <div class:list={["px-4 py-2 text-center text-[0.74rem] font-semibold md:hidden", !overlay && "border-t border-[var(--color-border)]"]} data-today-nav>{today.navStatus}</div>
</header>
