# Keep false until real Supabase + Turnstile integration tests are validated.
# Server-only deployment gate; setting credentials alone must never enable ordering.
FORNO_ORDERS_ENABLED=false
# Use real validation by default. official-test is accepted ONLY on the dedicated Vercel Preview
# branch and the exact test Supabase project pinned in src/config/order-environments.config.ts.
# VERCEL_ENV and VERCEL_GIT_COMMIT_REF are supplied by Vercel, never by request headers.
FORNO_TURNSTILE_MODE=real
# Server only. On Cloudflare local dev use .dev.vars; production values go in Sites runtime secrets.
# Supabase: real Project URL from the Connect dialog / Data API settings.
SUPABASE_URL=TODO_SUPABASE_PROJECT_URL
# Supabase: Settings > API Keys > Secret key (never a publishable/anon key).
SUPABASE_SECRET_KEY=TODO_SUPABASE_SECRET_KEY
# Generate a random 32-byte server secret; independent of Supabase.
ORDER_RATE_LIMIT_SALT=TODO_RANDOM_SECRET_AT_LEAST_32_BYTES
# Cloudflare Turnstile widget: real domain and action "order" are verified server-side.
TURNSTILE_SECRET_KEY=TODO_TURNSTILE_SECRET_KEY
# Public widget key, served by the availability API; never a Supabase key.
TURNSTILE_SITE_KEY=TODO_TURNSTILE_SITE_KEY
# Existing optional contact form (public by design).
PUBLIC_WEB3FORMS_ACCESS_KEY=TODO_WEB3FORMS_ACCESS_KEY

# Private BFF admin; enable only on the isolated Preview during development.
# Uses the existing server-side Supabase credentials. No browser key is needed.
FORNO_ADMIN_ENABLED=false
