{
  "name": "pizza-camion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "test:checkout": "node --test scripts/test-checkout.mjs",
    "check:todo": "node scripts/check-todos.mjs",
    "validate:production": "npm run check:todo && npm run check && npm run build",
    "test:admin": "node --test scripts/test-admin.mjs",
    "test:orders": "node --test scripts/test-orders.mjs",
    "test:turnstile:network": "node scripts/verify-turnstile-network.mjs",
    "build:sites": "FORNO_DEPLOY_TARGET=sites astro build && node scripts/package-astro-worker.mjs",
    "test:push": "node --test scripts/test-push.mjs",
    "test:production": "node --test scripts/test-production.mjs",
    "prepare:production": "node scripts/prepare-production-release.mjs",
    "build:production": "VERCEL_ENV=production astro build"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.0",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "11.0.16",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "gsap": "^3.15.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@electric-sql/pglite": "^0.5.12",
    "typescript": "^6.0.3",
    "wrangler": "^4.154.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "overrides": {
    "@cloudflare/vite-plugin": {
      "undici": "7.30.1"
    },
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
}
